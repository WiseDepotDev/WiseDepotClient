<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 桥只在进程内监听 127.0.0.1；联网权限是给 BridgeServer 背后的 OkHttp 用的 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      系统通知（消息）。Android 13（API 33）起是**运行时权限**：进入应用时请求一次，
      被拒时壳会**撤回**能力声明 `notify.system`（"声明即承诺"：不画永远不工作的开关）。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      相机扫码。`required="false"` 是刻意的：没有摄像头的设备（部分手持终端、工业 PDA）
      照样要能装、能跑 —— 只是界面上不出现扫码入口。
      能力声明与这里呼应：宿主只在真的有摄像头时才声明 `scan.camera`（见 ShellBridge）。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      NFC 读卡（B3）。**不声明 `android.permission.NFC`**：读卡不需要它
      （那是给"卡模拟/写卡/点对点"用的），我们只做读，加一条用不到的危险级权限
      只是白给用户一个警告。
      `required="false"` 与相机同理：没有 NFC 的设备（大多数桌面替代品、部分 PDA）
      照样要能装能跑 —— 只是界面上不出现任何 NFC 入口。
      能力声明与这里呼应：宿主只在**有硬件且真机验过**时才声明 `nfc.read`
      （见 ShellBridge 的 NFC_READ_VERIFIED）。
    -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".ShellApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.WiseShell"
        android:usesCleartextTraffic="false">

        <!--
          锁竖屏 + 不可缩放 —— 与旧 APP 一致，也是"手机端"这个产品定位应有的形态。

          只写 screenOrientation 在 WSA 上**不生效**：WSA 以 `mode=freeform`（自由窗口）跑应用，
          而 Android 在自由窗口 / 多窗口下会**忽略**方向请求。必须同时声明 resizeableActivity="false"，
          系统才会把方向请求当真。这两条一起才是完整的修法（实测：只加前者，视口仍是 1280x656 横屏）。

          放开竖屏锁的条件与旧仓 B5 相同：横屏各档真的验收过之后再放开。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
