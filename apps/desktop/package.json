{
  "name": "@wise/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "桌面宿主：Electron 主进程 —— 承载 Web 产物、spawn jlink JVM 桥、供给 __bridge.json",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main.cjs && esbuild src/smokePing.ts --bundle --platform=browser --format=iife --global-name=__wiseSmokePing --target=es2022 --outfile=dist/smoke-ping.js",
    "start": "electron ."
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.huicang.wise.depot",
    "productName": "慧仓智控 WiseDepot",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../bridge/host-desktop/build/install/wise-bridge/lib",
        "to": "bridge/lib"
      },
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "WiseDepot-Setup-${version}.${ext}"
    }
  }
}
